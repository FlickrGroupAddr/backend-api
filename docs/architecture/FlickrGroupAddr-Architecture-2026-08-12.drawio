<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0">
  <diagram id="fga-arch-2026-08-12" name="FlickrGroupAddr Architecture">
    <mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="FlickrGroupAddr Architecture" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="24" width="640" height="34" as="geometry" />
        </mxCell>
        <mxCell id="date" value="2026-08-12" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="60" width="300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Cloudflare-native &#183; the Flickr account is the identity &#183; no PII held beyond the Flickr NSID" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="50" y="86" width="760" height="22" as="geometry" />
        </mxCell>

        <mxCell id="cfframe" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1A1A1A;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="1230" height="1000" as="geometry" />
        </mxCell>
        <mxCell id="cflogo" value="CLOUDFLARE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6821F;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="140" width="132" height="44" as="geometry" />
        </mxCell>
        <mxCell id="netb" value="Cloudflare global network &#8212; anycast, no regions to choose" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#F6821F;dashed=1;strokeWidth=2;verticalAlign=top;fontColor=#F6821F;fontStyle=1;fontSize=13;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="100" y="200" width="1170" height="890" as="geometry" />
        </mxCell>

        <mxCell id="secrets" value="&lt;b&gt;Secrets Store&lt;/b&gt;&lt;br&gt;&lt;i&gt;3 account-level secrets:&lt;br&gt;Flickr consumer key + secret,&lt;br&gt;master encryption key&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B7280;strokeColor=none;fontColor=#FFFFFF;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="170" y="250" width="190" height="85" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="&lt;i&gt;Per-user Flickr tokens MUST NOT live here. Secrets Store caps at 100 secrets per account (1 store, 1024 B each), so it hits a wall at 100 users. It is the right home for app-level secrets only &#8212; the same trap the 2022 design hit with per-user SSM parameters.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="170" y="345" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cron" value="&lt;b&gt;Cron Trigger&lt;/b&gt;&lt;br&gt;&lt;i&gt;safety-net sweeper&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBAD41;strokeColor=none;fontColor=#3A2200;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="170" y="470" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="&lt;b&gt;D1 (SQLite)&lt;/b&gt;&lt;br&gt;&lt;i&gt;group metadata cache&lt;/i&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=13;whiteSpace=wrap;html=1;fillColor=#00A3E0;strokeColor=none;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="175" y="655" width="180" height="95" as="geometry" />
        </mxCell>

        <mxCell id="oauthdo" value="&lt;b&gt;OAuth Dance DO&lt;/b&gt;&lt;br&gt;&lt;i&gt;one per oauth_token&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0051C3;strokeColor=none;fontColor=#FFFFFF;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="250" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;API Worker&lt;/b&gt;&lt;br&gt;&lt;i&gt;backend-api&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6821F;strokeColor=none;fontColor=#FFFFFF;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="470" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="queuedo" value="&lt;b&gt;User Queue DO&lt;/b&gt;&lt;br&gt;&lt;i&gt;one per Flickr NSID &#183; SQLite storage&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0051C3;strokeColor=none;fontColor=#FFFFFF;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="690" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="pages" value="&lt;b&gt;Cloudflare Pages&lt;/b&gt;&lt;br&gt;&lt;i&gt;JAMstack UI&lt;br&gt;flickrgroupaddr.com&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6821F;strokeColor=none;fontColor=#FFFFFF;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="440" width="180" height="95" as="geometry" />
        </mxCell>

        <mxCell id="users" value="Users" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=2;fontSize=13;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1410" y="300" width="80" height="100" as="geometry" />
        </mxCell>
        <mxCell id="flickr" value="&lt;b&gt;Flickr API&lt;/b&gt;&lt;br&gt;&lt;i&gt;flickr.com&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF0084;strokeColor=none;fontColor=#FFFFFF;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1360" y="690" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="a1" value="&lt;i&gt;Holds the request-token secret across the user's redirect to flickr.com. Strongly consistent, so it cannot race the callback &#8212; KV's 60 s propagation can, and that failure is intermittent and PoP-dependent.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="840" y="232" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;i&gt;SQLite storage holds this user's pending (photo, group) requests, the per-group daily counters, and the AES-GCM encrypted Flickr token. setAlarm() reschedules to that user's next quota window &#8212; so there is no global nightly table scan and no thundering herd at 00:01 UTC.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="170" y="820" width="350" height="140" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;i&gt;Alarm delivery is at-least-once. The handler MUST be idempotent per (photo, group), or a retried alarm submits the same add twice.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="850" y="835" width="245" height="110" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;i&gt;Per-group daily add limits are the reason this system exists. A single request may retry for weeks before it lands.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1350" y="830" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="&lt;i&gt;Every call HMAC-SHA1 signed (OAuth 1.0a). Verified working in workerd against RFC 2202 vectors, 2026-08-12.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="880" y="600" width="230" height="80" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&#8212;&#8212;&#8212; request / response&lt;br&gt;&#8211; &#8211; &#8211; scheduled or event-driven" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1080" y="975" width="190" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;startArrow=classic;startFill=1;strokeWidth=2;strokeColor=#1A1A1A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="users" target="pages">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="fetch /api/v1/*&lt;br&gt;session cookie" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;startArrow=classic;startFill=1;strokeWidth=2;strokeColor=#1A1A1A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pages" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="stash / retrieve&lt;br&gt;request-token secret" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;startArrow=classic;startFill=1;strokeWidth=2;strokeColor=#1A1A1A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="api" target="oauthdo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="OAuth 1.0a&lt;br&gt;request_token &#183; access_token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;startArrow=classic;startFill=1;strokeWidth=2;strokeColor=#1A1A1A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;exitDx=0;exitDy=0;" edge="1" parent="1" source="api" target="flickr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="authorize at flickr.com" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;startArrow=classic;startFill=1;strokeWidth=2;strokeColor=#1A1A1A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="users" target="flickr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="submit / list requests" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;startArrow=classic;startFill=1;strokeWidth=2;strokeColor=#1A1A1A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="api" target="queuedo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="flickr.groups.pools.add" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;startArrow=classic;startFill=1;strokeWidth=2;strokeColor=#1A1A1A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="queuedo" target="flickr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="alarm(): wake at next quota window" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;dashed=1;strokeColor=#1A1A1A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="queuedo" target="queuedo">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="632" y="805" />
              <mxPoint x="728" y="805" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e9" value="sweep for lost alarms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeWidth=2;dashed=1;strokeColor=#1A1A1A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cron" target="queuedo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#1A1A1A;fontSize=11;" edge="1" parent="1" source="secrets" target="api">
          <mxGeometry relative="1" as="geometry" />

        <mxCell id="apilink" value="&lt;b&gt;/auth/device-link/enter-user-code&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B85C0A;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=26.0001;arcSize=14;" vertex="1" parent="1">

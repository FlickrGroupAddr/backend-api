        <mxCell id="apirest" value="&lt;b&gt;/api/v001/*&lt;/b&gt; API endpoints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B85C0A;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=26.0001;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="1131.7994" y="853.0951" width="520.002" height="72.0003" as="geometry" />
        </mxCell>
        <mxCell id="retry" value="&lt;b&gt;Nightly Retry Logic&lt;/b&gt;&lt;br&gt;&lt;i&gt;Cloudflare Worker&lt;br&gt;Attempt to flush every queue with&lt;br&gt;pending requests. Stop a queue at&lt;br&gt;its first throttle status&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6821F;strokeColor=none;fontColor=#FFFFFF;fontSize=30.0001;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1091.7992" y="1680.1983" width="600.0023" height="234.0009" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="&lt;b&gt;SQL Database&lt;/b&gt;&lt;br&gt;&lt;i&gt;Cloudflare D1&lt;br&gt;Users · requests · tokens&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00A3E0;strokeColor=none;fontColor=#FFFFFF;fontSize=28.0001;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1804.602" y="1401.7972" width="338.0013" height="222.0009" as="geometry" />
        </mxCell>

        <mxCell id="flickr" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF0084;strokeWidth=6;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="2430.9996" y="817.495" width="472.0018" height="1209.5047" as="geometry" />
        </mxCell>
        <mxCell id="flickrtitle" value="Flickr" style="text;html=1;align=center;verticalAlign=middle;fontSize=40.0002;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="2480.9997" y="1049.4959" width="372.0014" height="64.0002" as="geometry" />
        </mxCell>
        <mxCell id="flickrapi" value="&lt;b&gt;Flickr API&lt;/b&gt;&lt;div style=&quot;font-size:28.0001px&quot;&gt;&lt;i&gt;OAuth 1.0a&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;font-size:30.0001px;border-bottom:4px solid #FFFFFF;display:inline-block;padding-bottom:6px;margin-top:96.0004px&quot;&gt;&lt;b&gt;OAuth Endpoints&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:28.0001px;line-height:44.0002px;margin-top:14.0001px&quot;&gt;/oauth/request_token&lt;/div&gt;&lt;div style=&quot;font-size:28.0001px;line-height:44.0002px&quot;&gt;/oauth/authorize&lt;/div&gt;&lt;div style=&quot;font-size:28.0001px;line-height:44.0002px&quot;&gt;/oauth/access_token&lt;/div&gt;&lt;div style=&quot;font-size:30.0001px;border-bottom:4px solid #FFFFFF;display:inline-block;padding-bottom:6px;margin-top:96.0004px&quot;&gt;&lt;b&gt;API Functions&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:28.0001px;line-height:44.0002px;margin-top:14.0001px&quot;&gt;groups.pools.getGroups&lt;/div&gt;&lt;div style=&quot;font-size:28.0001px;line-height:44.0002px&quot;&gt;photos.getAllContexts&lt;/div&gt;&lt;div style=&quot;font-size:28.0001px;line-height:44.0002px&quot;&gt;groups.pools.add&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF0084;strokeColor=none;fontColor=#FFFFFF;fontSize=40.0002;arcSize=8;verticalAlign=top;spacingTop=32.0001;" vertex="1" parent="1">
          <mxGeometry x="2480.9997" y="1213.4965" width="372.0014" height="757.1029" as="geometry" />
        </mxCell>
        <mxCell id="flickrlogo" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml," vertex="1" parent="1">
          <mxGeometry x="2480.9997" y="867.4952" width="372.0014" height="176.1007" as="geometry" />
        </mxCell>
                <mxCell id="justification" value="&lt;b&gt;Project Justification&lt;/b&gt;&lt;div style=&quot;margin-left:52.0002px;font-size:26.0001px&quot;&gt;Flickr caps how many photos a member may add to a group each day. Doing it by hand means coming back every day for weeks. FGA queues each request and keeps retrying until it lands.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#B0B0B0;fontSize=28.0001;spacingLeft=20.0001;spacingTop=16.0001;spacingRight=16.0001;" vertex="1" parent="1">
          <mxGeometry x="2430.9996" y="192.6926" width="472.0018" height="295.0011" as="geometry" />
        </mxCell>

        <mxCell id="key" value="&lt;b&gt;Legend&lt;/b&gt;&lt;div style=&quot;margin-left:52.0002px;font-size:26.0001px&quot;&gt;&lt;span style=&quot;display:inline-block;width:78.0003px;margin-right:20.0001px;border-bottom:4px solid #1A1A1A;vertical-align:middle&quot;&gt;&lt;/span&gt;Synchronous transfer&lt;/div&gt;&lt;div style=&quot;margin-left:52.0002px;font-size:26.0001px&quot;&gt;&lt;span style=&quot;display:inline-block;width:78.0003px;margin-right:20.0001px;border-bottom:4px dotted #1A1A1A;vertical-align:middle&quot;&gt;&lt;/span&gt;Asynchronous trigger&lt;/div&gt;&lt;div style=&quot;margin-left:52.0002px;font-size:24.0001px;margin-top:26.0001px&quot;&gt;Why it is built this way:&lt;/div&gt;&lt;div style=&quot;margin-left:52.0002px;font-size:24.0001px&quot;&gt;docs/architecture/DECISIONS.md&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#B0B0B0;fontSize=28.0001;spacingLeft=20.0001;spacingTop=16.0001;" vertex="1" parent="1">
          <mxGeometry x="2430.9996" y="532.5939" width="472.0018" height="240.0009" as="geometry" />
        </mxCell>

        <mxCell id="journey" value="&lt;div style=&quot;font-size:32.0001px;border-bottom:4px solid #1A1A1A;display:inline-block;padding-bottom:6px&quot;&gt;&lt;b&gt;Auth Data Flow&lt;/b&gt;&lt;/div&gt;&lt;table cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;margin-top:14.0001px;border-collapse:collapse&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:right;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;User clicks &lt;b&gt;Authorize with FGA&lt;/b&gt; button in LrC Plugin&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:right;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;Plugin resolves DNS for fga.com&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:right;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;3&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;Plugin HTTPS POST to /auth/device-link/start&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:right;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;4&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;Server creates Durable Object identified by &lt;b&gt;User Code&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:right;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;5&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;Server responds w/ &lt;b&gt;User Code&lt;/b&gt; and &lt;b&gt;Device Code&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:right;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;6&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;LrC Plugin displays &lt;b&gt;User Code&lt;/b&gt; on screen and launches browser w/ URL: /auth/device-link/enter-user-code&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:right;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;7&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;Browser resolves DNS for fga.com&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:right;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;8&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;Browser HTTPS GET: /auth/device-link/enter-user-code&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:right;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;9&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;/auth/device-link/enter-user-code returns HTTP redirect to /auth/flickr/login, due to absence of &lt;b&gt;FGA Session ID&lt;/b&gt; cookie in request headers&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:left;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;10&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;Browser redirected, HTTPS GET: /auth/flickr/login&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:left;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;11&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;Server reads Flickr API creds from Worker Secrets&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:left;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;12&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;Server makes signed call to Flickr /oauth/request_token&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:left;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;13&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;Flickr responds w/ &lt;b&gt;Request Token&lt;/b&gt;, &lt;b&gt;Request Secret&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:left;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;14&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;Server creates Durable Object identified by &lt;b&gt;Request Token&lt;/b&gt;, holding &lt;b&gt;Request Secret&lt;/b&gt; and return path&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:left;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;15&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;/auth/flickr/login returns HTTP redirect to Flickr API /oauth/authorize, carrying &lt;b&gt;Request Token&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:left;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;Browser redirected, HTTPS GET: Flickr API /oauth/authorize, carrying &lt;b&gt;Request Token&lt;/b&gt; in oauth_token URL query parameter&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:left;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;17&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;User grants FGA &lt;b&gt;write&lt;/b&gt; access on their entire Flickr account, w/ manual click in their browser&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:left;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;18&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;Flickr API returns HTTP redirect to /auth/flickr/callback, carrying &lt;b&gt;Request Token&lt;/b&gt; and &lt;b&gt;Verifier&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:left;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;19&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;Browser redirected, HTTPS GET: /auth/flickr/callback, carrying &lt;b&gt;Request Token&lt;/b&gt; and &lt;b&gt;Verifier&lt;/b&gt; in oauth_token and oauth_verifier URL query parameters&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:left;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;20&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;Server reads and deletes Durable Object, recovering &lt;b&gt;Request Secret&lt;/b&gt; and return path&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:left;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;21&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;Server calls Flickr /oauth/access_token, signed w/ &lt;b&gt;Request Secret&lt;/b&gt;, carrying &lt;b&gt;Verifier&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:left;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;22&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;Flickr responds w/ &lt;b&gt;Access Token&lt;/b&gt;, &lt;b&gt;Access Secret&lt;/b&gt;, NSID and username&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:left;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;23&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;Server encrypts &lt;b&gt;Access Token&lt;/b&gt; and &lt;b&gt;Access Secret&lt;/b&gt; under &lt;b&gt;Token Key&lt;/b&gt;, writes user row to D1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:left;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;24&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;Server creates &lt;b&gt;FGA Session ID&lt;/b&gt; and writes its &lt;span style=&quot;white-space:nowrap&quot;&gt;SHA2-256&lt;/span&gt; hash to D1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:left;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;25&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;/auth/flickr/callback returns HTTP redirect to /auth/device-link/enter-user-code, setting host-only &lt;b&gt;FGA Session ID&lt;/b&gt; cookie for fga.com&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:left;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;26&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;Browser redirected w/ &lt;b&gt;FGA Session ID&lt;/b&gt; cookie, HTTPS GET: &lt;span style=&quot;white-space:nowrap&quot;&gt;/auth/device-link/enter-user-code&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:left;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;27&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;User reads &lt;b&gt;User Code&lt;/b&gt; from LrC Plugin and submits via browser form; browser HTTPS POST to &lt;span style=&quot;white-space:nowrap&quot;&gt;/auth/device-link/approve&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:left;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;28&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;Server marks Durable Object approved, attaching user's Flickr NSID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:left;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;29&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;Plugin polls /auth/device-link/poll w/ &lt;b&gt;Device Code&lt;/b&gt;, repeating since step 6&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:left;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;30&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;Polling read returns &lt;b&gt;FGA Session ID&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:left;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;31&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;Plugin saves session ID in LrC secure credential store&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:32.0001px;text-align:left;padding-right:20.0001px;vertical-align:top;font-size:24.4001px&quot;&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;font-size:24.4001px&quot;&gt;Plugin performs FGA app operations against /api/v001/*&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#003087;strokeWidth=4;fontSize=30.0001;spacingLeft=24.0001;spacingTop=16.0001;spacingRight=20.0001;" vertex="1" parent="1">
          <mxGeometry x="3102.9973" y="192.6926" width="695.0027" height="1834.3071" as="geometry" />
        </mxCell>


{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fga-backend-api",
	"main": "src/index.ts",

	// ADR-13: track current. Bump deliberately, and re-run `wrangler types` after.
	"compatibility_date": "2026-08-13",

	// ADR-13 deliberately omits "nodejs_compat". hono, jose and zod are all
	// Web-standard and zero-dependency. If a future dependency forces the flag,
	// ADR-13 requires naming that dependency in the same commit.
	"compatibility_flags": [],

	// Public configuration, not secrets. ADR-12: the UI and the API are separate
	// origins, and the CORS allowlist is compared against this exact value --
	// never against the request's own Origin header.
	//
	// Both point at the workers.dev hostname because flickrgroupaddr.com is not
	// owned yet -- it is in pendingDelete and a watcher is waiting to buy it back.
	// Aiming API_BASE_URL at a domain that does not resolve would send Flickr a
	// callback URL it cannot reach, and the failure would happen inside Flickr's
	// redirect where there is nothing useful to read.
	//
	// ADR-12 describes the END state, where the UI and API are separate origins.
	// Today they are the same origin, which makes the CORS contract inert rather
	// than wrong. **Both values MUST be revisited when the domain lands**, and
	// ADR-12's contract only starts doing work at that point.
	"vars": {
		"UI_ORIGIN": "https://fga-backend-api.terryott.workers.dev",
		"API_BASE_URL": "https://fga-backend-api.terryott.workers.dev"
	},

	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},

	// ADR-04: the nightly sweep is the v1 work engine. 00:15 UTC rather than
	// 00:00 -- nothing here needs midnight exactly, and the hour boundary is the
	// busiest moment on the shared cron infrastructure.
	"triggers": {
		"crons": ["15 0 * * *"]
	},

	"d1_databases": [
		{
			// The binding is DB, not the `fga` wrangler suggests on creation --
			// the code says env.DB and the two names are independent.
			"binding": "DB",
			"database_name": "fga",
			// Created 2026-08-13, region ENAM. Local development and the test suite
			// use Miniflare's own D1 and never read this value.
			"database_id": "0a54cbfa-770e-4b6d-a792-a5b65e5fa6be"
		}
	],

	"durable_objects": {
		"bindings": [
			{
				// ADR-02: one object per login attempt, NOT per user. The name says so
				// because that distinction is the whole point of the decision.
				"name": "OAUTH_LOGIN",
				"class_name": "OAuthLoginAttempt"
			}
		]
	},

	"migrations": [
		{
			"tag": "v1",
			// SQLite-backed storage, which is the current default for new classes.
			"new_sqlite_classes": ["OAuthLoginAttempt"]
		}
	]
}

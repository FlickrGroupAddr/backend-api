{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fga-backend-api",
	"main": "src/index.ts",

	// ADR-13: track current. Bump deliberately, and re-run `wrangler types` after.
	"compatibility_date": "2026-08-16",

	// ADR-13 deliberately omits "nodejs_compat". hono, jose and zod are all
	// Web-standard and zero-dependency. If a future dependency forces the flag,
	// ADR-13 requires naming that dependency in the same commit.
	"compatibility_flags": [],

	// Public configuration, not secrets.
	//
	// ADR-18: one origin serves the app shell, the API and the OAuth legs, so these
	// two are deliberately the SAME value. They stay as two bindings because the
	// CORS contract reads UI_ORIGIN and the OAuth callback builds from
	// API_BASE_URL, and collapsing them would bury which one a future second
	// origin has to change.
	//
	// The domain landed 2026-08-14. It is registered at Amazon Registrar with its
	// nameservers pointing at Cloudflare, which is all a Workers custom domain at
	// the apex needs -- a Cloudflare zone is not a registration.
	//
	// **These MUST match the custom domain actually attached to the Worker.** A
	// mismatch sends Flickr an oauth_callback it cannot reach, and that failure
	// happens inside Flickr's redirect where there is nothing useful to read.
	"vars": {
		"UI_ORIGIN": "https://flickrgroupaddr.com",
		"API_BASE_URL": "https://flickrgroupaddr.com"
	},

	// ADR-18. The apex, as a Workers Custom Domain.
	//
	// Cloudflare provisions the A/AAAA records and the certificate itself. **Do
	// NOT add DNS for the apex by hand** -- a manual record conflicts with the
	// one this creates, and the conflict shows up as intermittent resolution
	// rather than as an error.
	//
	// `custom_domain: true` rather than a zone route: a route pattern attaches
	// the Worker to traffic that already reaches Cloudflare, while a custom
	// domain also creates the DNS to get it there. The apex needs both.
	// **`www` is deliberately NOT a route here, and the attempt is recorded
	// because it looked obviously correct and was not.**
	//
	// Adding it as a custom domain and 301-ing in the Worker fails, and fails in
	// the worst direction: `not_found_handling: "single-page-application"` serves
	// index.html for /queue BEFORE the Worker is invoked, because /queue is not
	// in `run_worker_first`. So the redirect never ran and www served the entire
	// app on a second hostname -- precisely the thing ADR-18 removes. Measured in
	// production 2026-08-14, then reverted.
	//
	// Making it work would mean `run_worker_first` covering navigations, which
	// means the Worker must serve assets itself through an ASSETS binding. That
	// is a lot of machinery to bounce a hostname.
	//
	// **www belongs in a Cloudflare Redirect Rule**, which runs at the edge
	// before Workers and before assets. See "Still open" in DECISIONS.md.
	"routes": [{ "pattern": "flickrgroupaddr.com", "custom_domain": true }],

	// **ADR-18 says one origin, and this is what makes that true rather than
	// merely intended.**
	//
	// Leaving workers.dev on would keep fga-backend-api.terryott.workers.dev
	// serving the same Worker, which resurrects the second origin the decision
	// removed -- and it would do so silently, since everything keeps working.
	// The CORS contract compares against UI_ORIGIN, so a session minted on the
	// workers.dev host would fail in ways that look like a cookie bug.
	"workers_dev": false,

	// ADR-18. The Svelte app is built by Vite into ./web/dist and served by this
	// same Worker.
	//
	// `run_worker_first` is the whole routing contract. Everything NOT listed here
	// is answered by the static assets without invoking the Worker at all, which
	// is why `/` reaches index.html and why the Worker MUST NOT register a route
	// there. The list is explicit rather than `true`: `true` would invoke the
	// Worker for every image and hashed bundle, which costs money and buys nothing.
	//
	// `single-page-application` serves index.html for any unmatched path, so a deep
	// link like /queue works on a cold load instead of 404ing. That replaces the
	// five hand-written _redirects rules the 2021 UI needed.
	"assets": {
		"directory": "./web/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/oauth/*", "/health"]
	},

	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},

	// ADR-06: the nightly sweep is the v1 work engine. 00:15 UTC rather than
	// 00:00 -- nothing here needs midnight exactly, and the hour boundary is the
	// busiest moment on the shared cron infrastructure.
	"triggers": {
		"crons": ["15 0 * * *"]
	},

	"d1_databases": [
		{
			// The binding is DB, not the `fga` wrangler suggests on creation --
			// the code says env.DB and the two names are independent.
			"binding": "DB",
			"database_name": "fga",
			// Created 2026-08-13, region ENAM. Local development and the test suite
			// use Miniflare's own D1 and never read this value.
			"database_id": "0a54cbfa-770e-4b6d-a792-a5b65e5fa6be"
		}
	],

	"durable_objects": {
		"bindings": [
			{
				// ADR-08: one object per login attempt, NOT per user. The name says so
				// because that distinction is the whole point of the decision.
				"name": "OAUTH_LOGIN",
				"class_name": "OAuthLoginAttempt"
			},
			{
				// One object per LINK ATTEMPT, not per user or per device. Same
				// reasoning as OAUTH_LOGIN above: at `start` nobody has authorized
				// anything, so there is no identity to key on yet.
				"name": "DEVICE_LINK",
				"class_name": "DeviceLinkAttempt"
			}
		]
	},

	"migrations": [
		{
			"tag": "v1",
			// SQLite-backed storage, which is the current default for new classes.
			"new_sqlite_classes": ["OAuthLoginAttempt"]
		},
		{
			// **A NEW TAG, never an edit to v1.** Migration tags are applied in order
			// and already-applied tags are not re-run, so adding a class to v1 would
			// be a no-op against any environment that has already seen v1 -- and it
			// would look correct in the file.
			"tag": "v2",
			"new_sqlite_classes": ["DeviceLinkAttempt"]
		}
	]
}

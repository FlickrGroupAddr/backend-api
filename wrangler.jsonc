{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fga-backend-api",
	"main": "src/index.ts",

	// ADR-13: track current. Bump deliberately, and re-run `wrangler types` after.
	"compatibility_date": "2026-08-14",

	// ADR-13 deliberately omits "nodejs_compat". hono, jose and zod are all
	// Web-standard and zero-dependency. If a future dependency forces the flag,
	// ADR-13 requires naming that dependency in the same commit.
	"compatibility_flags": [],

	// Public configuration, not secrets.
	//
	// ADR-18: one origin serves the app shell, the API and the OAuth legs, so these
	// two are deliberately the SAME value. They stay as two bindings because the
	// CORS contract reads UI_ORIGIN and the OAuth callback builds from
	// API_BASE_URL, and collapsing them would bury which one a future second
	// origin has to change.
	//
	// The domain landed 2026-08-14. It is registered at Amazon Registrar with its
	// nameservers pointing at Cloudflare, which is all a Workers custom domain at
	// the apex needs -- a Cloudflare zone is not a registration.
	//
	// **These MUST match the custom domain actually attached to the Worker.** A
	// mismatch sends Flickr an oauth_callback it cannot reach, and that failure
	// happens inside Flickr's redirect where there is nothing useful to read.
	"vars": {
		"UI_ORIGIN": "https://flickrgroupaddr.com",
		"API_BASE_URL": "https://flickrgroupaddr.com"
	},

	// ADR-18. The Svelte app is built by Vite into ./web/dist and served by this
	// same Worker.
	//
	// `run_worker_first` is the whole routing contract. Everything NOT listed here
	// is answered by the static assets without invoking the Worker at all, which
	// is why `/` reaches index.html and why the Worker MUST NOT register a route
	// there. The list is explicit rather than `true`: `true` would invoke the
	// Worker for every image and hashed bundle, which costs money and buys nothing.
	//
	// `single-page-application` serves index.html for any unmatched path, so a deep
	// link like /queue works on a cold load instead of 404ing. That replaces the
	// five hand-written _redirects rules the 2021 UI needed.
	"assets": {
		"directory": "./web/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/oauth/*", "/health"]
	},

	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},

	// ADR-06: the nightly sweep is the v1 work engine. 00:15 UTC rather than
	// 00:00 -- nothing here needs midnight exactly, and the hour boundary is the
	// busiest moment on the shared cron infrastructure.
	"triggers": {
		"crons": ["15 0 * * *"]
	},

	"d1_databases": [
		{
			// The binding is DB, not the `fga` wrangler suggests on creation --
			// the code says env.DB and the two names are independent.
			"binding": "DB",
			"database_name": "fga",
			// Created 2026-08-13, region ENAM. Local development and the test suite
			// use Miniflare's own D1 and never read this value.
			"database_id": "0a54cbfa-770e-4b6d-a792-a5b65e5fa6be"
		}
	],

	"durable_objects": {
		"bindings": [
			{
				// ADR-08: one object per login attempt, NOT per user. The name says so
				// because that distinction is the whole point of the decision.
				"name": "OAUTH_LOGIN",
				"class_name": "OAuthLoginAttempt"
			}
		]
	},

	"migrations": [
		{
			"tag": "v1",
			// SQLite-backed storage, which is the current default for new classes.
			"new_sqlite_classes": ["OAuthLoginAttempt"]
		}
	]
}

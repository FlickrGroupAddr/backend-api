# Copy to .dev.vars for local development. .dev.vars is gitignored -- the repo is
# public, and these are the four values ADR-03 names.
#
# In production these are Worker secrets, set with `wrangler secret put NAME`.
# They are NOT in wrangler.jsonc, which is committed.

# From https://www.flickr.com/services/apps/create/
FLICKR_CONSUMER_KEY="local-development-placeholder"
FLICKR_CONSUMER_SECRET="local-development-placeholder"

# AES-GCM, encrypts each user's Flickr token before it reaches D1 (ADR-03).
# Generate with: openssl rand -base64 32
# MUST decode to exactly 32 bytes -- the code refuses anything else.
TOKEN_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

# HMAC-SHA256, signs the session cookie (ADR-06). MUST be a different value from
# TOKEN_KEY: rotating this one logs everyone out and costs nothing, while
# rotating TOKEN_KEY means re-encrypting every stored Flickr token. Sharing a key
# makes the cheap rotation as expensive as the dear one, so neither ever happens.
# Generate with: openssl rand -base64 32
SESSION_KEY="BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB="

# ADR-19. A JSON array of the NSIDs allowed to reach /api/v001/admin/*.
#
# A secret rather than a `vars` entry not because an NSID is confidential -- it is
# on every Flickr profile -- but because wrangler.jsonc is committed to a public
# repository, and publishing who can read operational data is free reconnaissance.
#
# MISSING, MALFORMED OR EMPTY ADMITS NOBODY. The parse fails closed on purpose:
# the tempting failure is the other way, where a config mistake reads as "no
# restriction" and quietly opens the dashboard to every signed-in user.
ADMIN_NSIDS='["00000000@N00"]'

# Local-only overrides, and they DO take precedence over the `vars` block in
# wrangler.jsonc -- verified 2026-08-13 by reading them back out of a running
# Worker rather than trusting the binding table, which shows .dev.vars values
# as "(hidden)" either way.
#
# BOTH point at the VITE port, not the Worker port. ADR-18 makes development
# same-origin through Vite's proxy: /api, /oauth and /health on :5173 are
# forwarded to the Worker on :8787, so the browser only ever sees :5173.
#
# Pointed at :8787 instead, the OAuth callback redirects to UI_ORIGIN and lands
# the browser on the Worker rather than the app, and the __Host- cookie is set
# on the wrong origin. That reads as a broken login, not a wrong port.
API_BASE_URL="http://localhost:5173"
UI_ORIGIN="http://localhost:5173"

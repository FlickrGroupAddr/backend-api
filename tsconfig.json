{
	"compilerOptions": {
		// Workers run a current V8. There is no downlevel target to serve here, and
		// compiling to anything older only obscures what the runtime actually does.
		"target": "es2022",
		"lib": ["es2022"],
		"module": "esnext",
		"moduleResolution": "bundler",

		// Generated by `wrangler types` from wrangler.jsonc. ADR-13 forbids
		// hand-writing the Env interface -- it drifts from the real bindings.
		"types": [
			"./worker-configuration.d.ts",
			"@cloudflare/vitest-pool-workers/types"
		],

		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,

		// Each file is transpiled alone by esbuild, so type-only imports must be
		// syntactically obvious rather than inferred across the program.
		"isolatedModules": true,
		"verbatimModuleSyntax": true,

		// Wrangler bundles and deploys; tsc is here to check, not to emit.
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": [
		"src/**/*.ts",
		"test/**/*.ts",
		"*.ts",
		"worker-configuration.d.ts"
	]
}

{
	"name": "fga-backend-api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "wrangler dev",
		"dev:web": "vite",
		"deploy": "npm run check && npm run build:web && wrangler deploy",
		"build:web": "vite build",
		"types": "wrangler types",
		"typecheck": "tsc --noEmit && tsc --noEmit -p web",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"trace": "python scripts/traceability.py --check",
		"dirty-words": "python scripts/claude-dirty-words.py",
		"lua": "python scripts/lua-balance.py docs/lrc-spike/plugin",
		"lua:lint": "selene docs/lrc-spike/plugin",
		"typehints": "python -m ruff check --no-cache scripts/",
		"types:py": "python -m pyright scripts/",
		"lsp": "python scripts/lsp-check.py",
		"lua:imports": "python scripts/lua-imports.py docs/lrc-spike/plugin",
		"check": "npm run typecheck && npm run lint && npm run dirty-words && npm run typehints && npm run types:py && npm run lsp && npm run lua && npm run lua:lint && npm run lua:imports && npm run test && npm run trace && npm run build:web"
	},
	"dependencies": {
		"hono": "4.13.2",
		"jose": "6.2.9",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.8",
		"@cloudflare/vitest-pool-workers": "0.21.3",
		"@fontsource-variable/inter": "5.3.0",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"svelte": "5.56.9",
		"typescript": "7.0.2",
		"vite": "8.2.1",
		"vitest": "4.1.10",
		"wrangler": "4.123.0"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"workerd@1.20260811.1": true
	}
}

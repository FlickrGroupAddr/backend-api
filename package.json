{
	"name": "fga-backend-api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"types": "wrangler types",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "npm run typecheck && npm run lint && npm run test"
	},
	"dependencies": {
		"hono": "4.13.2",
		"jose": "6.2.8",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.8",
		"@cloudflare/vitest-pool-workers": "0.21.3",
		"typescript": "7.0.2",
		"vitest": "4.1.10",
		"wrangler": "4.123.0"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"workerd@1.20260811.1": true
	}
}
